# .env
# OpenAI API Key (required if using OpenAI embeddings or LLM)
OPENAI_API_KEY=your-openai-api-key-here

# Vector database configuration
VECTOR_DB_PATH=./vector_store
VECTOR_DB_TYPE=chromadb

# PDF upload path
PDF_UPLOAD_PATH=../data

# Embedding model (choose one: text-embedding-ada-002, all-MiniLM-L6-v2, etc.)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM configuration (choose one: gpt-3.5-turbo, gpt-4, gemini-pro, etc.)
# LLM_MODEL=llama3
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
MAX_TOKENS=1000
LLAMA_SERVER_URL=http://localhost:11434

LLM_PROVIDER=google
GOOGLE_API_KEY=AIzaSyCO0nndWx6Y0yURiMlXdhnHc5ooKT9_v-w

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_PROVIDER=huggingface
# Chunking configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval configuration
RETRIEVAL_K=5
SIMILARITY_THRESHOLD=0.7

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS configuration (json array comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://5387-103-228-242-221.ngrok-free.app"]

# Logging configuration
LOG_LEVEL=INFO
